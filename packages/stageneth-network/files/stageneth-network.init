START=20
STOP=90

USE_PROCD=1

start_service() {
    /usr/sbin/stageneth-network apply
}

reload_service() {
    /usr/sbin/stageneth-network apply
}

service_triggers() {
    procd_add_reload_trigger stageneth
}
