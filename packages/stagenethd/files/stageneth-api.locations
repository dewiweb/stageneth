location /api/ {
    # this file lands in every nginx server block (http _lan + https
    # _ssl) — never serve the API over plaintext, credentials included
    if ($scheme = http) {
        return 403;
    }
    proxy_pass http://unix:/var/run/stageneth-api.sock:;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # SSE (/api/v1/events) and long-poll endpoints must not be buffered
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    client_max_body_size 8m;
}
