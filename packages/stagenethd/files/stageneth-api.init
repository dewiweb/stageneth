START=80
STOP=20

USE_PROCD=1

start_service() {
    config_load stagenethd
    config_get_bool enabled main enabled 1
    [ "$enabled" -eq 1 ] || return 0

    procd_open_instance
    procd_set_param command /usr/sbin/stageneth-api
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger stagenethd
}
