location / {
    # this file lands in every nginx server block (http _lan + https _ssl)
    # — the admin UI is TLS-only, bounce plaintext to https
    if ($scheme = http) {
        return 301 https://$host$request_uri;
    }
    root /www-stageneth;
    ssi on;
    ssi_silent_errors on;
    try_files $uri $uri/ /index.html;
}
