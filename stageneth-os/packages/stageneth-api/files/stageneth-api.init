#!/bin/sh /etc/rc.common

# Copyright (C) 2026 StageNeth Contributors
# SPDX-License-Identifier: GPL-2.0-only

START=80
STOP=20

USE_PROCD=1

start_service() {
    config_load stageneth-api
    config_get_bool enabled main enabled 1
    [ "$enabled" -eq 1 ] || return 0

    config_get bind main bind 127.0.0.1
    config_get port main port 8090
    config_get secret main secret change-me

    procd_open_instance
    procd_set_param command /usr/sbin/stageneth-api
    procd_set_param env STAGENETH_BIND="$bind"
    procd_set_param env STAGENETH_PORT="$port"
    procd_set_param env STAGENETH_SECRET="$secret"
    procd_set_param respawn
    procd_close_instance
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger stageneth-api
}
