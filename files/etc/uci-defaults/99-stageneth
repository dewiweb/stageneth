#!/bin/sh
# StageNeth first-boot defaults

# Set root password to 'stageneth' for test image
hash='$1$stagenet$CYrKd38gWkJlOcsKAu/UN0'
sed -i "s|^root:[^:]*:|root:${hash}:|" /etc/shadow

# Set StageNeth hostname
uci set system.@system[0].hostname="StageNeth"
uci commit system

# Ensure services start at boot
/etc/init.d/nginx enable
/etc/init.d/stageneth-api enable
/etc/init.d/stagenethd enable

exit 0
