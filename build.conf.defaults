OWRT_VERSION=v24.10.5
STAGENETH_VERSION=0.3.0
REPO_CHANNEL=dev
# Target = nom d'un fichier dans config/targets/. Disponibles :
#   x86_64        — PC/mini-PC/VM générique (GRUB BIOS+EFI)
#   armsr         — ARM64 générique (QEMU virt, cartes EFI)
#   nanopi_r4s    — NanoPi R4S  (RK3399,  2x 1GbE)
#   nanopi_r5s    — NanoPi R5S  (RK3568S, 2x 2.5G + 1G)
#   nanopi_r6s    — NanoPi R6S  (RK3588S, 2x 2.5G + 1G)
#   rpi4          — Raspberry Pi 4 (1G onboard + USB NIC)
#   bpi_r3        — Banana Pi BPI-R3 (4x 1G + 2x SFP)
#   bpi_r4        — Banana Pi BPI-R4 (4x 1G + 2x SFP+ 10G)
# Routeurs grand public compatibles OpenWrt :
#   glinet_mt6000      — GL.iNet Flint 2   (2x 2.5G + 4x 1G)
#   glinet_mt3000      — GL.iNet Beryl AX  (2.5G + 1G, pocket)
#   xiaomi_ax3000t     — Xiaomi AX3000T    (4x 1G, ~40 EUR)
#   linksys_e8450      — Linksys E8450 / Belkin RT3200 (4+1x 1G)
#   dynalink_dl-wrx36  — Dynalink DL-WRX36 (IPQ8072A, 4+1x 1G)
# Professionnel / industriel :
#   mikrotik_rb5009    — MikroTik RB5009 (7x1G + 2.5G + 10G SFP+, rackable)
#   mikrotik_760igs    — MikroTik hEX S (5x 1G + SFP)
#   zyxel_xgs1250      — Zyxel XGS1250-12 : switch géré 2.5G/10G/SFP+
#   hpe_1920_48g_poe   — HPE 1920-48G PoE+ : switch 48 ports PoE
#   panasonic_m48eg    — Panasonic M48EG : switch broadcast AVoIP
TARGET=x86_64
BUILD_SEMVER_SUFFIX=-beta.19
